<?xml version="1.0" encoding="UTF-8"?>
<interface domain="clapper-app">
  <object class="GtkShortcutsWindow" id="help_overlay">
    <property name="modal">true</property>
    <child>
      <object class="GtkShortcutsSection">
        <property name="section-name">app</property>
        <child>
          <object class="GtkShortcutsGroup">
            <property name="title" translatable="yes">General</property>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-new-window">
                <property name="title" translatable="yes">New window</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-preferences">
                <property name="title" translatable="yes">Open preferences</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-show-help-overlay">
                <property name="title" translatable="yes">Show shortcuts</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-info">
                <property name="title" translatable="yes">Show information</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-about">
                <property name="title" translatable="yes">About</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-pipeline">
                <property name="title" translatable="yes">Show pipeline</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-toggle-fullscreen">
                <property name="title" translatable="yes">Toggle fullscreen</property>
                <property name="subtitle" translatable="yes">Double tap | Double click</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-unfullscreen">
                <property name="title" translatable="yes">Unfullscreen</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-auto-resize">
                <property name="title" translatable="yes">Auto window resize</property>
                <property name="subtitle" translatable="yes">Middle click</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-quit">
                <property name="title" translatable="yes">Quit</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkShortcutsGroup">
            <property name="title" translatable="yes">Media</property>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-add-files">
                <property name="title" translatable="yes">Add Files…</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-add-folder">
                <property name="title" translatable="yes">Add Folder…</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-add-uri">
                <property name="title" translatable="yes">Add URI…</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkShortcutsGroup">
            <property name="title" translatable="yes">Queue</property>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-next-item">

                <property name="title" translatable="yes">Next item</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-previous-item">

                <property name="title" translatable="yes">Previous item</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-progression-mode">
                <property name="title" translatable="yes">Change progression mode</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkShortcutsGroup">
            <property name="title" translatable="yes">Playback</property>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-toggle-play">
                <property name="title" translatable="yes">Toggle play</property>
                <property name="subtitle" translatable="yes">Tap | Left click</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-seek-forward-ltr">
                <property name="direction">ltr</property>
                <property name="title" translatable="yes">Seek forward</property>
                <property name="subtitle" translatable="yes">Double tap (right side) | Scroll right</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-seek-forward-rtl">
                <property name="direction">rtl</property>
                <property name="title" translatable="yes">Seek forward</property>
                <property name="subtitle" translatable="yes">Double tap (left side) | Scroll left</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-seek-backward-ltr">
                <property name="direction">ltr</property>
                <property name="title" translatable="yes">Seek backward</property>
                <property name="subtitle" translatable="yes">Double tap (left side) | Scroll left</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-seek-backward-rtl">
                <property name="direction">rtl</property>
                <property name="title" translatable="yes">Seek backward</property>
                <property name="subtitle" translatable="yes">Double tap (right side) | Scroll right</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-volume-up">
                <property name="title" translatable="yes">Volume up</property>
                <property name="subtitle" translatable="yes">Scroll up</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-volume-down">
                <property name="title" translatable="yes">Volume down</property>
                <property name="subtitle" translatable="yes">Scroll down</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-toggle-mute">
                <property name="title" translatable="yes">Toggle mute</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-toggle-subtitles">
                <property name="title" translatable="yes">Toggle subtitles</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-cycle-subtitle-stream">
                <property name="title" translatable="yes">Cycle subtitle track</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-cycle-audio-stream">
                <property name="title" translatable="yes">Cycle audio track</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-next-subtitle">
                <property name="title" translatable="yes">Next subtitle</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-previous-subtitle">
                <property name="title" translatable="yes">Previous subtitle</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-speed-up">
                <property name="title" translatable="yes">Speed up</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-speed-down">
                <property name="title" translatable="yes">Speed down</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-advance-frame">
                <property name="title" translatable="yes">Advance frame</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkShortcutsGroup">
            <child>
              <object class="GtkShortcutsShortcut" id="sc-next-chapter">

                <property name="title" translatable="yes">Next chapter</property>
              </object>
            </child>
            <child>
              <object class="GtkShortcutsShortcut" id="sc-previous-chapter">

                <property name="title" translatable="yes">Previous chapter</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
